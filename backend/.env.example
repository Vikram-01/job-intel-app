# Copy to .env and fill in. Never commit .env.
# Comma-separated SHA-256 digests of API keys. Create a key with:  python scripts/gen_api_key.py
JOBINTEL_API_KEY_HASHES=
JOBINTEL_DATABASE_URL=sqlite:///./jobintel.db
# Daily sync time (UTC). 01:30 UTC = 07:00 IST.
JOBINTEL_SYNC_HOUR_UTC=1
JOBINTEL_SYNC_MINUTE_UTC=30
JOBINTEL_RATE_LIMIT=60/minute
JOBINTEL_SYNC_RATE_LIMIT=4/hour
JOBINTEL_MAX_UPLOAD_BYTES=5242880
